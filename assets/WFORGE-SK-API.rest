@baseUrl = https://your-project.supabase.co/rest/v1
@authUrl = https://your-project.supabase.co/auth/v1
@apiKey = YOUR_SUPABASE_ANON_KEY
@jwt = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_AFTER_LOGIN

################################################################
# W//FORGE-SK-API.rest  v0.1.0
# 8 Groups · 24 Endpoints · Supabase-compatible
# Use with VS Code "REST Client" extension
################################################################

# ============================================================
# GROUP 1: AUTH  (2 endpoints)
# ============================================================

### 1.1 Login with email/password
POST {{authUrl}}/token?grant_type=password
apikey: {{apiKey}}
Content-Type: application/json

{
  "email": "bank@wforge.one",
  "password": "REPLACE_PASSWORD"
}

### 1.2 Get current session
GET {{authUrl}}/user
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

# ============================================================
# GROUP 2: PROJECTS  (3 endpoints)
# ============================================================

### 2.1 List my projects
GET {{baseUrl}}/projects?select=id,slug,name,status,created_at&order=created_at.desc
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Prefer: return=representation

### 2.2 Create new project
POST {{baseUrl}}/projects
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json
Prefer: return=representation

{
  "slug": "njxo-s03-offeyez",
  "name": "NINJAXO S03 · OFFEYEZ Takeover",
  "brief": "Season 03 campaign with OFFEYEZ as lead character",
  "priority": "high",
  "owner_id": "{{jwt}}"
}

### 2.3 Get project full detail
GET {{baseUrl}}/projects?id=eq.PROJECT_ID&select=*,characters(*),prompts(*),renders(*),qc_reports(*)
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

# ============================================================
# GROUP 3: CHARACTERS  (4 endpoints)
# ============================================================

### 3.1 Create character (DRAFT · unlocked)
POST {{baseUrl}}/characters
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json
Prefer: return=representation

{
  "slug": "offeyez",
  "name": "OFFEYEZ",
  "version": "3.0.0",
  "locked": false,
  "drift_limit": 0.03,
  "age": 20,
  "height_cm": 175,
  "weight_kg": 54,
  "personality": "Quiet / Confident / Elegant / Mysterious",
  "archetype": "Luxury Streetwear Devil",
  "dna": {
    "face": "Sharp high cheekbone, almond eyes upward 8deg, defined jawline",
    "hair": "Platinum silver twin tail, mid-back length, cool blue undertone",
    "signature": "Glossy red devil horns (pair), ruby tint visor, gold geometric earrings",
    "body": "175cm 54kg, elegant confident stance",
    "eyes": "Hazel, default: mysterious half-lidded",
    "skin": "Fair, clean, no tattoo",
    "brand_base": "Matte black premium top, gold jewelry"
  },
  "sheet": {
    "role": "Brand Ambassador",
    "voice": "Low warm tone, slow articulate",
    "brand_voice": "Premium dark, confident minimal"
  }
}

### 3.2 🔒 LOCK character → Bump version + generate hash
POST {{baseUrl}}/rpc/character_lock
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "char_id": "CHAR_UUID_FROM_3.1" }

### 3.3 Get character libraries by type
GET {{baseUrl}}/char_libraries?char_id=eq.CHAR_ID&type=eq.outfit&order=version.desc
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

### 3.4 Character version history
GET {{baseUrl}}/char_versions?char_id=eq.CHAR_ID&order=created_at.desc
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

# ============================================================
# GROUP 4: PROMPTS  (4 endpoints)
# ============================================================

### 4.1 🧩 Build modular prompt (HEART OF ENGINE)
POST {{baseUrl}}/rpc/prompt_build
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "char_id": "CHAR_ID",
  "modules": [
    { "id": "camera",   "value": "ARRI Alexa 35mm f/1.8, slight low angle, cinematic wide" },
    { "id": "pose",     "value": "Standing confident, head back 15deg, one hand in pocket" },
    { "id": "lighting", "value": "3pt neon: crimson key L, cyan rim back, soft fill 20%" },
    { "id": "scene",    "value": "Rainy Neo-Tokyo alley night, wet asphalt reflections" },
    { "id": "material", "value": "Horns glossy deep red, visor 75% ruby tint" },
    { "id": "typography", "value": "NO TEXT OVERLAY — brand safe" },
    { "id": "render",   "value": "Seedream 5.0 Pro, photorealism 8K, grain 3.5%" }
  ],
  "negative": [
    "identity drift","face drift","bad anatomy","extra limbs","bad hands",
    "wrong hair color","text overlay","watermark","blurry","overexposed"
  ],
  "params": {
    "cfg": 7.5, "steps": 32, "sampler": "DPM++ 2M Karras",
    "width": 1024, "height": 1536, "seed": -1,
    "controlnet": ["openpose","ip_adapter_identity"]
  }
}

### 4.2 Validate drift of a module vs locked DNA
POST {{baseUrl}}/rpc/prompt_validate_drift
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "char_id": "CHAR_ID",
  "module_id": "hair",
  "value": "platinum silver twin tail"
}

### 4.3 Prompt version diff
GET {{baseUrl}}/rpc/prompt_diff?a=PROMPT_ID_A&b=PROMPT_ID_B
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

### 4.4 List prompts by character
GET {{baseUrl}}/prompts?char_id=eq.CHAR_ID&order=created_at.desc&limit=20
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

# ============================================================
# GROUP 5: BUNDLES / BAPG  (2 endpoints)
# ============================================================

### 5.1 🔐 BAPG Authorize → create immutable bundle
POST {{baseUrl}}/rpc/bundle_authorize
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "project_id": "PROJECT_ID",
  "char_id": "CHAR_ID",
  "prompt_id": "PROMPT_ID",
  "note": "Final master v14 for NINJAXO S03"
}

### 5.2 Get bundle by ID
GET {{baseUrl}}/bundles?id=eq.BUNDLE_ID&select=*,character:char_id(*),prompt:prompt_id(*)
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

# ============================================================
# GROUP 6: RENDER  (3 endpoints)
# ============================================================

### 6.1 Submit render job (requires valid bundle)
POST {{baseUrl}}/renders
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json
Prefer: return=representation

{
  "bundle_id": "BUNDLE_ID",
  "count": 4,
  "priority": "normal",
  "seed_override": null
}

### 6.2 Render queue status
GET {{baseUrl}}/renders?select=id,status,progress,seed,qc_score,created_at&order=created_at.desc&limit=50
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

### 6.3 Cancel running job
PATCH {{baseUrl}}/renders?id=eq.RENDER_ID
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json
Prefer: return=representation

{ "status": "cancelled" }

# ============================================================
# GROUP 7: QC  (3 endpoints)
# ============================================================

### 7.1 Run auto QC on a finished render
POST {{baseUrl}}/rpc/qc_run
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{ "render_id": "RENDER_ID" }

### 7.2 Get QC report with 8 axes
GET {{baseUrl}}/qc_reports?render_id=eq.RENDER_ID
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

### 7.3 Flag / reject a render
POST {{baseUrl}}/qc_reports
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json
Prefer: return=representation

{
  "render_id": "RENDER_ID",
  "identity": 98, "face": 96, "anatomy": 72, "typography": 95,
  "logo": 100, "brand": 97, "prompt": 94, "consistency": 88,
  "overall": 92,
  "flagged": true,
  "note": "Anomaly: 6 fingers on left hand",
  "decision": "delta_refine"
}

# ============================================================
# GROUP 8: ASSETS + EXPORT  (3 endpoints)
# ============================================================

### 8.1 Upload asset (get signed URL)
POST {{baseUrl}}/rpc/asset_sign_upload
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "project_id": "PROJECT_ID",
  "filename": "OFFEYEZ_MASTER_014.png",
  "content_type": "image/png",
  "kind": "master_render",
  "size_bytes": 12450000
}

### 8.2 List export presets
GET {{baseUrl}}/export_presets?select=*&order=name
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}

### 8.3 Start export job
POST {{baseUrl}}/rpc/export_start
apikey: {{apiKey}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "project_id": "PROJECT_ID",
  "preset_ids": ["master_4k","feed_1080","story_916"],
  "watermark": true,
  "metadata": true
}

