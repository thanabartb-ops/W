NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Proves to the Supabase conversation runtime that a request came
# from this gateway rather than straight from a browser holding a user token.
# Must be distinct from LSUPERAGENT_GATEWAY_HMAC_SECRET, must match the value in
# the runtime's secret store, and must never appear in a NEXT_PUBLIC_ value.
RUNTIME_SHARED_SECRET=
